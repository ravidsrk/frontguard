{
  "name": "@frontguard/cli",
  "version": "0.2.3",
  "description": "Local visual regression testing with reviewed git baselines and optional model-assisted analysis.",
  "type": "module",
  "bin": {
    "frontguard": "./dist/cli/index.js",
    "frontguard-render": "./bin/frontguard-render"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "import": "./dist/plugins/index.js"
    }
  },
  "scripts": {
    "build": "tsup && cp src/render/overflow-probe.js dist/overflow-probe.js",
    "dev": "tsup --watch",
    "test": "vitest run --pool=forks --exclude='test/e2e/**'",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node ./scripts/check-readme-version.mjs && npm run build"
  },
  "keywords": [
    "visual-regression",
    "testing",
    "playwright",
    "screenshot",
    "ai",
    "frontend",
    "ci"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "bin",
    "action.yml",
    "action-run.sh",
    "Dockerfile",
    "docker",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ravidsrk/frontguard"
  },
  "homepage": "https://frontguard.dev",
  "bugs": {
    "url": "https://github.com/ravidsrk/frontguard/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@storybook/csf-tools": "^8.6.14",
    "chalk": "^6.0.0",
    "commander": "^15.1.0",
    "hono": "^4.13.17",
    "ora": "^10.0.0",
    "pixelmatch": "^8.0.0",
    "playwright": "1.65.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@axe-core/playwright": "~4.14.0",
    "@daytona/sdk": "^0.231.0",
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "author": "Ravindra Kumar <ravidsrk@gmail.com>"
}
