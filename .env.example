# Frontguard — environment reference
#
# Copy to `.env` and fill in what you need. Nothing here is required to run the
# local CLI: `frontguard init` + `update-baselines` + `run` work with no
# environment at all. Everything below enables an optional capability.
#
# This file is the single source of truth for the environment contract. It is
# generated from the variables the code actually reads; if you add a new
# `env.FOO` lookup, add it here in the same change.
#
# ---------------------------------------------------------------------------
# CLI — AI analysis (optional; disabled when unset)
# ---------------------------------------------------------------------------
# Bring your own key. Set either one to enable AI classification of regressions.
# Spend is bounded by your own provider limits: Frontguard does not proxy these.
FRONTGUARD_OPENAI_KEY=
FRONTGUARD_ANTHROPIC_KEY=

# Figma design-comparison plugin (optional).
FIGMA_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# CLI — telemetry (opt-in; OFF unless explicitly enabled)
# ---------------------------------------------------------------------------
# Telemetry is disabled by default. Set to 1 to opt in. It sends only command
# name, version, route/regression counts, duration and error type — never URLs,
# file paths, screenshots, or keys. See docs/telemetry.md for the full schema.
# Any of the following suppress it: FRONTGUARD_TELEMETRY=0, --no-telemetry,
# `telemetry: false` in config, or the DO_NOT_TRACK convention below.
FRONTGUARD_TELEMETRY=
FRONTGUARD_TELEMETRY_ENDPOINT=
# Honoured as a standard opt-out. DO_NOT_TRACK=1 disables telemetry entirely.
DO_NOT_TRACK=

# ---------------------------------------------------------------------------
# CLI — rendering and debugging (optional)
# ---------------------------------------------------------------------------
FRONTGUARD_DEBUG=
FRONTGUARD_DOCKER_IMAGE=
FRONTGUARD_DOCKER_PLATFORM=
FRONTGUARD_DISABLE_BYTE_COMPARE=

# Baseline upload to S3/R2 (optional; requires the @aws-sdk/client-s3 peer).
FRONTGUARD_S3_ACCESS_KEY=
FRONTGUARD_S3_SECRET_KEY=

# Daytona sandbox, used by --verify-fixes --fix-sandbox daytona (optional).
DAYTONA_API_KEY=

# ---------------------------------------------------------------------------
# Integrations — GitHub App / Slack / Vercel / Netlify clients
# ---------------------------------------------------------------------------
# Every integration talks to the hosted API with these two.
FRONTGUARD_API_URL=
FRONTGUARD_API_KEY=

# GitHub App (integrations/github-app)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
FRONTGUARD_CALLBACK_SECRET=
FRONTGUARD_PREVIEW_URL_TEMPLATE=

# Slack app (integrations/slack-app)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=
SLACK_SCOPES=
SLACK_TEAMS=

# ---------------------------------------------------------------------------
# cloud-api (packages/cloud-api) — Cloudflare Workers
# ---------------------------------------------------------------------------
# Not deployed today. Secrets are set with `wrangler secret put NAME`, not from
# this file; it documents the contract. Bindings (D1, R2 SCREENSHOTS) live in
# wrangler.toml and are not environment variables.
API_BASE_URL=
PUBLIC_BASE_URL=

# REQUIRED in production. Signs the fg_session dashboard cookie. High-entropy,
# >= 32 chars: `openssl rand -base64 32`. If unset, every /dashboard route fails
# closed with HTTP 503. Never reuse the dev fallback from src/auth/session.ts.
DASHBOARD_SESSION_SECRET=

# GitHub OAuth for the dashboard.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_URL=

# Email alerts.
RESEND_API_KEY=
ALERT_FROM_EMAIL=

# Billing. No live money path exists today; deploying billing re-opens payment
# and PCI obligations that are currently out of scope.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
BILLING_SUCCESS_URL=
BILLING_CANCEL_URL=

# OpenTelemetry export (optional).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# ---------------------------------------------------------------------------
# Read, never set by you
# ---------------------------------------------------------------------------
# These are injected by CI providers and platforms and are listed only so the
# inventory is complete. Do not set them yourself.
#
#   CI detection:  CI, GITHUB_ACTIONS, GITLAB_CI, TRAVIS, CIRCLECI,
#                  BUILDKITE, JENKINS_URL
#   GitHub Actions: GITHUB_REF, GITHUB_REPOSITORY, GITHUB_RUN_ID,
#                  GITHUB_SERVER_URL, GITHUB_API_URL, GITHUB_TOKEN
#   Netlify:       URL, DEPLOY_URL, DEPLOY_PRIME_URL, CONTEXT, COMMIT_REF,
#                  HEAD, REVIEW_ID, REPOSITORY_URL
